{
  "name": "slr-agent-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for SLR agent review tasks",
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "bin": {
    "slr-agent-mcp": "./out/index.js"
  },
  "files": [
    "out",
    "README.md"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && vitest run --config vitest.config.ts",
    "test:harness": "npm run compile && vitest run --config vitest.config.ts tests/acceptance.test.ts",
    "start": "node out/index.js",
    "pack:check": "npm run compile && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}

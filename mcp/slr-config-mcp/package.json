{
  "name": "slr-config-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for safe SLR profile and connector configuration",
  "type": "module",
  "main": "./out/index.js",
  "types": "./out/index.d.ts",
  "files": ["out", "README.md"],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile && vitest run --config vitest.config.ts",
    "start": "node out/index.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
